# foodllm データベース ER図（MVP版）

## 概要

本ドキュメントでは、foodllm システム（MVP版）で使用するデータベース（Azure Cosmos DB）のエンティティ関連図を定義します。

---

## MVP vs Phase 2 エンティティ

| エンティティ | MVP | Phase 2 | 説明 |
|-------------|-----|---------|------|
| SESSIONS | ✅ | | セッション管理 |
| CONVERSATIONS | ✅ | | 会話（管理者参照用） |
| MESSAGES | ✅ | | メッセージ |
| SUGGESTIONS | ✅ | | サジェスト |
| RECIPES | ✅ | | レシピマスタ |
| PRODUCTS | ✅ | | 製品マスタ |
| PRODUCT_FAQ | ✅ | | 製品FAQマスタ |
| USE_CASES | ✅ | | ユースケース設定 |
| SUGGESTION_RULES | ✅ | | サジェストルール |
| FEEDBACK | ✅ | | フィードバック |
| USERS | - | ✅ | ユーザー管理（Phase 2） |
| USER_PREFERENCES | - | ✅ | ユーザー設定（Phase 2） |
| ANALYTICS_EVENTS | - | ✅ | 分析イベント（Phase 2） |

---

## ER図（Mermaid）- MVP版

```mermaid
erDiagram
    %% ============================================
    %% MVP メインエンティティ
    %% ============================================
    
    SESSIONS ||--|{ CONVERSATIONS : "has"
    CONVERSATIONS ||--|{ MESSAGES : "contains"
    CONVERSATIONS ||--o{ FEEDBACK : "receives"
    MESSAGES ||--o{ SUGGESTIONS : "has"
    MESSAGES ||--o| RECIPES : "references"
    MESSAGES ||--o{ PRODUCTS : "references"
    USE_CASES ||--o{ CONVERSATIONS : "belongs_to"
    USE_CASES ||--o{ RECIPES : "contains"
    USE_CASES ||--o{ PRODUCTS : "contains"
    USE_CASES ||--o{ PRODUCT_FAQ : "contains"
    USE_CASES ||--o{ SUGGESTION_RULES : "has"
    PRODUCTS ||--o{ PRODUCT_FAQ : "has"

    %% ============================================
    %% セッション（MVP）
    %% ============================================
    SESSIONS {
        string id PK "セッションID（UUID）"
        string use_case_id FK "ユースケースID"
        string device_type "デバイス種別"
        string user_agent "ユーザーエージェント"
        datetime created_at "作成日時"
        datetime last_active_at "最終アクティブ日時"
        int ttl "TTL（秒）"
    }

    %% ============================================
    %% 会話（管理者参照用）
    %% ============================================
    CONVERSATIONS {
        string id PK "会話ID（UUID）"
        string session_id FK "セッションID"
        string use_case_id FK "ユースケースID"
        string status "ステータス（active/completed）"
        int message_count "メッセージ数"
        string first_user_message "最初のユーザーメッセージ"
        int total_tokens "合計トークン数"
        datetime started_at "開始日時"
        datetime ended_at "終了日時"
        datetime created_at "作成日時"
        datetime updated_at "更新日時"
        int ttl "TTL（秒）"
    }

    %% ============================================
    %% メッセージ
    %% ============================================
    MESSAGES {
        string id PK "メッセージID（UUID）"
        string conversation_id FK "会話ID"
        string role "送信者（user/assistant/system）"
        string content "メッセージ内容"
        string intent "検出された意図"
        object metadata "メタデータ"
        string recipe_id "関連レシピID"
        array product_ids "関連製品ID配列"
        array faq_ids "関連FAQ ID配列"
        int tokens_used "使用トークン数"
        int response_time_ms "応答時間（ms）"
        datetime created_at "作成日時"
        int ttl "TTL（秒）"
    }

    %% ============================================
    %% サジェスト（クイックリプライ）
    %% ============================================
    SUGGESTIONS {
        string id PK "サジェストID（UUID）"
        string message_id FK "メッセージID"
        string label "表示ラベル"
        string value "送信値"
        string type "タイプ（text/action）"
        string icon "アイコン名"
        int order "表示順序"
        boolean selected "選択されたか"
        datetime selected_at "選択日時"
        datetime created_at "作成日時"
    }

    %% ============================================
    %% フィードバック
    %% ============================================
    FEEDBACK {
        string id PK "フィードバックID（UUID）"
        string session_id FK "セッションID"
        string conversation_id FK "会話ID"
        string message_id FK "メッセージID"
        string rating "評価（positive/negative）"
        string comment "コメント"
        datetime created_at "作成日時"
    }

    %% ============================================
    %% レシピ
    %% ============================================
    RECIPES {
        string id PK "レシピID"
        string use_case_id FK "ユースケースID"
        string title "レシピ名"
        string description "説明"
        array ingredients "材料リスト"
        array steps "調理手順"
        int cooking_time "調理時間（分）"
        int servings "人数"
        string difficulty "難易度（easy/medium/hard）"
        array tags "タグ配列"
        string image_url "画像URL"
        object nutrition "栄養情報"
        string source_url "元レシピURL"
        float rating "評価"
        int view_count "閲覧数"
        datetime created_at "作成日時"
        datetime updated_at "更新日時"
    }

    %% ============================================
    %% 製品
    %% ============================================
    PRODUCTS {
        string id PK "製品ID"
        string use_case_id FK "ユースケースID"
        string name "製品名"
        string description "説明"
        string category "カテゴリ"
        array usage "使用用途"
        object nutrition "栄養成分"
        string image_url "画像URL"
        string product_url "製品ページURL"
        array sizes "サイズ展開"
        boolean is_active "有効フラグ"
        datetime created_at "作成日時"
        datetime updated_at "更新日時"
    }

    %% ============================================
    %% 製品FAQ
    %% ============================================
    PRODUCT_FAQ {
        string id PK "FAQ ID"
        string product_id FK "製品ID"
        string use_case_id FK "ユースケースID"
        string question "質問"
        string answer "回答"
        string category "カテゴリ（保存方法/使い方/アレルギー等）"
        array keywords "キーワード配列"
        int priority "優先度"
        boolean is_active "有効フラグ"
        datetime created_at "作成日時"
        datetime updated_at "更新日時"
    }

    %% ============================================
    %% ユースケース設定
    %% ============================================
    USE_CASES {
        string id PK "ユースケースID"
        string name "ユースケース名"
        string display_name "表示名"
        string description "説明"
        object theme "テーマ設定（カラー等）"
        string system_prompt "システムプロンプト"
        object llm_config "LLM設定"
        boolean is_active "有効フラグ"
        datetime created_at "作成日時"
        datetime updated_at "更新日時"
    }

    %% ============================================
    %% サジェストルール
    %% ============================================
    SUGGESTION_RULES {
        string id PK "ルールID"
        string use_case_id FK "ユースケースID"
        string trigger_type "トリガータイプ"
        string intent "対象意図"
        array suggestions "サジェスト配列"
        int priority "優先度"
        boolean is_active "有効フラグ"
        datetime created_at "作成日時"
        datetime updated_at "更新日時"
    }
```

